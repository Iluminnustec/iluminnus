// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusTela {
  ATIVA
  INATIVA
  MANUTENCAO
}

enum TipoTela {
  TV_ELEVADOR
  TOTEM_HALL
  TELA_HORIZONTAL
  OUTRO
}

enum StatusCobranca {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum CategoriaDespesa {
  EQUIPAMENTO
  ESTOQUE
  INSTALACAO
  MANUTENCAO
  MARKETING
  ADMINISTRATIVO
  COMISSAO
  OUTROS
}

enum FormaPagamento {
  A_VISTA
  CARTAO_CREDITO
  PIX
  BOLETO
  TRANSFERENCIA
}

enum StatusParcela {
  PENDENTE
  PAGO
  ATRASADO
}

enum StatusEstoque {
  DISPONIVEL
  EM_USO
  MANUTENCAO
  BAIXADO
}

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
}

enum Cargo {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  VENDAS
  SOCIO
}

enum TipoMidia {
  IMAGEM
  VIDEO
}

enum StatusProposta {
  PENDENTE
  APROVADA
  RECUSADA
}

enum StatusAssinatura {
  ATIVA
  ATRASADA
  SUSPENSA
  CANCELADA
}

// O "dono": uma empresa que assina o Telas. Toda entidade de negocio abaixo
// pertence a uma Empresa (multi-tenant). Usuario.empresaId e
// LogAtividade.empresaId sao os unicos opcionais -- null neles significa
// "staff da propria Iluminnus" (ver Cargo.SUPER_ADMIN), nao um dono.
model Empresa {
  id        String   @id @default(cuid())
  nome      String
  slug      String   @unique
  dominio   String?  @unique
  cidade    String?
  estado    String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quem indicou esse dono pra Iluminnus (programa de indicação/afiliado).
  // Se preenchido, todo pagamento de assinatura dessa Empresa gera uma
  // ComissaoIndicacao pro indicador, enquanto a Empresa continuar assinante.
  indicadorId String?
  indicador   Indicador? @relation(fields: [indicadorId], references: [id])

  assinatura   Assinatura?
  licencas     Licenca[]
  usuarios     Usuario[]
  logsAtividade LogAtividade[]
  clientes     Cliente[]
  propostas    Proposta[]
  comissoes    Comissao[]
  predios      Predio[]
  telas        Tela[]
  dispositivos Dispositivo[]
  playlists    Playlist[]
  midias       Midia[]
  cobrancas    Cobranca[]
  despesas     Despesa[]
  vendas       Venda[]
  fechamentosComissao FechamentoComissao[]
  itensEstoque ItemEstoque[]
  comissoesIndicacao ComissaoIndicacao[]
}

// Pessoa (não necessariamente um Usuario do sistema) que indica novos donos
// pra Iluminnus e recebe comissão recorrente enquanto eles forem assinantes.
model Indicador {
  id               String   @id @default(cuid())
  nome             String
  contato          String?
  chavePix         String?
  percentualPadrao Float    @default(20)
  // Código curto usado no link público de indicação (/assinar?ref=codigo).
  // Quem se cadastra por esse link já nasce vinculado a este indicador,
  // sem precisar de nenhuma ação manual depois -- essencial pro fluxo de
  // venda presencial (vendedor preenche o cadastro do cliente na hora,
  // pelo próprio link dela) e pro cadastro direto pelo site.
  codigo           String   @unique
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())

  empresas  Empresa[]
  comissoes ComissaoIndicacao[]
}

enum StatusComissaoIndicacao {
  PENDENTE
  PAGA
}

// Uma linha por pagamento de assinatura recebido de uma Empresa que tem
// indicador -- gerada automaticamente em registrarPagamento(). 1:1 com o
// PagamentoAssinatura de origem pra nunca duplicar comissão do mesmo pagamento.
model ComissaoIndicacao {
  id                    String                  @id @default(cuid())
  percentual            Float
  valorPago             Float
  valorComissao         Float
  status                StatusComissaoIndicacao @default(PENDENTE)
  dataPagamentoComissao DateTime?
  createdAt             DateTime                @default(now())

  indicadorId String
  indicador   Indicador @relation(fields: [indicadorId], references: [id])

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  pagamentoAssinaturaId String              @unique
  pagamentoAssinatura   PagamentoAssinatura @relation(fields: [pagamentoAssinaturaId], references: [id], onDelete: Cascade)

  @@index([indicadorId])
  @@index([empresaId])
}

// Registro central da Iluminnus: qual produto (App) cada Empresa tem
// licenciado. Hoje só existe o Telas, mas o modelo já é multi-app -- uma
// Empresa pode vir a ter mais de uma Licenca (uma por App) no futuro.
model App {
  id        String   @id @default(cuid())
  nome      String
  slug      String   @unique
  createdAt DateTime @default(now())

  licencas  Licenca[]
}

enum StatusLicenca {
  ATIVA
  SUSPENSA
  CANCELADA
}

model Licenca {
  id        String        @id @default(cuid())
  codigo    String        @unique
  status    StatusLicenca @default(ATIVA)
  criadaEm  DateTime      @default(now())

  empresaId String
  empresa   Empresa       @relation(fields: [empresaId], references: [id])

  appId     String
  app       App           @relation(fields: [appId], references: [id])

  @@unique([empresaId, appId])
}

model Assinatura {
  id                String           @id @default(cuid())
  plano             String
  valorMensal       Float
  diaVencimento     Int
  status            StatusAssinatura @default(ATIVA)
  dataInicio        DateTime         @default(now())
  proximoVencimento DateTime
  // Preenchido em cadastros via período de teste (/assinar). Enquanto no
  // futuro, a empresa tem acesso mesmo sem pagamento registrado ainda.
  trialAte          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  empresaId         String     @unique
  empresa           Empresa    @relation(fields: [empresaId], references: [id])

  pagamentos        PagamentoAssinatura[]
}

model PagamentoAssinatura {
  id            String     @id @default(cuid())
  valor         Float
  referencia    DateTime
  dataPagamento DateTime   @default(now())
  registradoPor String?
  observacoes   String?
  createdAt     DateTime   @default(now())

  assinaturaId  String
  assinatura    Assinatura @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  comissaoIndicacao ComissaoIndicacao?
}

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  senhaHash    String
  cargo        Cargo    @default(SUPERVISOR)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // null = staff da propria Iluminnus (cargo SUPER_ADMIN), nao pertence a
  // nenhum dono.
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id])

  despesasAdiantadas Despesa[]
  clientesVendidos   Cliente[]
  comissoes          Comissao[]
  vendas             Venda[]
  fechamentosComissao FechamentoComissao[]

  @@index([empresaId])
}

model LogAtividade {
  id           String   @id @default(cuid())
  usuarioNome  String
  usuarioEmail String
  acao         String
  entidade     String
  entidadeId   String?
  descricao    String
  createdAt    DateTime @default(now())

  // null = acao de nivel plataforma (feita por um SUPER_ADMIN da Iluminnus).
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
}

model Cliente {
  id           String   @id @default(cuid())
  nome         String
  razaoSocial  String?
  cnpjCpf      String?
  email        String?  @unique
  senhaHash    String?
  telefone     String?
  endereco     String?
  bairro       String?
  cidade       String?
  estado       String?
  cep          String?
  planoTelas   Int?
  observacoes  String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id])

  cobrancas    Cobranca[]
  midias       Midia[]

  vendedorId   String?
  vendedor     Usuario?  @relation(fields: [vendedorId], references: [id])
  comissoes    Comissao[]
  propostas    Proposta[]
  vendas       Venda[]

  @@index([empresaId])
}

model Proposta {
  id          String         @id @default(cuid())
  valorTotal  Float
  status      StatusProposta @default(PENDENTE)
  observacoes String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  empresaId   String
  empresa     Empresa        @relation(fields: [empresaId], references: [id])

  clienteId   String
  cliente     Cliente        @relation(fields: [clienteId], references: [id])

  itens       PropostaItem[]

  @@index([empresaId])
}

model PropostaItem {
  id             String   @id @default(cuid())
  precoNoMomento Float

  propostaId     String
  proposta       Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  telaId         String
  tela           Tela     @relation(fields: [telaId], references: [id])
}

model Comissao {
  id            String   @id @default(cuid())
  valorVenda    Float
  percentual    Float
  valorComissao Float
  dataVenda     DateTime
  createdAt     DateTime @default(now())

  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])

  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id])

  vendedorId    String
  vendedor      Usuario  @relation(fields: [vendedorId], references: [id])

  despesaId     String   @unique
  despesa       Despesa  @relation(fields: [despesaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

model Predio {
  id           String   @id @default(cuid())
  nome         String
  endereco     String?
  bairro       String?
  cidade       String?
  estado       String?
  cep          String?
  latitude     Float?
  longitude    Float?
  sindicoNome  String?
  sindicoContato String?
  observacoes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id])

  telas        Tela[]

  @@index([empresaId])
}

model Tela {
  id             String     @id @default(cuid())
  nome           String
  tipo           TipoTela   @default(TV_ELEVADOR)
  especificacoes String?
  status         StatusTela @default(ATIVA)
  rotacao        Int        @default(0)
  observacoes    String?
  precoBase      Float      @default(110)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  empresaId      String
  empresa        Empresa    @relation(fields: [empresaId], references: [id])

  predioId       String
  predio         Predio     @relation(fields: [predioId], references: [id])

  playlistId     String?
  playlist       Playlist?  @relation(fields: [playlistId], references: [id])

  dispositivos   Dispositivo[]
  midias         Midia[]    @relation("MidiaTelas")
  propostaItens  PropostaItem[]

  @@index([empresaId])
}

model Dispositivo {
  id             String    @id @default(cuid())
  deviceId       String    @unique
  apelido        String?
  ultimoContato  DateTime  @default(now())
  appVersao      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Preenchido quando o dispositivo e vinculado a uma Tela (copiado da
  // empresa da tela). Um deviceId recem pareado, ainda sem telaId, fica
  // sem empresa ate alguem vincular.
  empresaId      String?
  empresa        Empresa?  @relation(fields: [empresaId], references: [id])

  telaId         String?
  tela           Tela?     @relation(fields: [telaId], references: [id])

  @@index([empresaId])
}

model Playlist {
  id        String   @id @default(cuid())
  nome      String
  isPadrao  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])

  itens     Midia[]
  telas     Tela[]

  @@index([empresaId])
}

model Midia {
  id               String    @id @default(cuid())
  nome             String
  tipo             TipoMidia
  url              String
  caminhoStorage   String
  duracaoSegundos  Int       @default(10)
  ordem            Int       @default(0)
  ativo            Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  empresaId        String
  empresa          Empresa   @relation(fields: [empresaId], references: [id])

  playlistId       String?
  playlist         Playlist? @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  clienteId        String?
  cliente          Cliente?  @relation(fields: [clienteId], references: [id])

  // Telas especificas onde essa midia deve aparecer. Vazio = institucional,
  // toca em todas as telas (comportamento padrao pra quem nao escolher nenhuma).
  telas            Tela[]    @relation("MidiaTelas")

  @@index([empresaId])
}

model Cobranca {
  id            String         @id @default(cuid())
  descricao     String
  valor         Float
  vencimento    DateTime
  status        StatusCobranca @default(PENDENTE)
  dataPagamento DateTime?
  observacoes   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  empresaId     String
  empresa       Empresa        @relation(fields: [empresaId], references: [id])

  clienteId     String
  cliente       Cliente        @relation(fields: [clienteId], references: [id])

  @@index([empresaId])
}

model Despesa {
  id             String           @id @default(cuid())
  descricao      String
  categoria      CategoriaDespesa @default(OUTROS)
  fornecedor     String?
  valorTotal     Float
  dataCompra     DateTime
  formaPagamento FormaPagamento   @default(A_VISTA)
  numeroParcelas Int              @default(1)
  faturarMesSeguinte Boolean      @default(false)
  observacoes    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  empresaId      String
  empresa        Empresa          @relation(fields: [empresaId], references: [id])

  parcelas       DespesaParcela[]

  pagoPorSocioId String?
  pagoPorSocio   Usuario?         @relation(fields: [pagoPorSocioId], references: [id])
  reembolsado    Boolean          @default(false)
  dataReembolso  DateTime?

  comissao       Comissao?
  fechamentoComissao FechamentoComissao?

  @@index([empresaId])
}

// Registro de uma venda nova (input do calculo de comissao mensal por faixa).
// Nao gera despesa sozinha -- entra na soma do mes do vendedor, que so vira
// despesa quando o mes e fechado (ver FechamentoComissao).
model Venda {
  id            String   @id @default(cuid())
  valorVenda    Float
  dataPagamento DateTime
  observacoes   String?
  createdAt     DateTime @default(now())

  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])

  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id])

  vendedorId    String
  vendedor      Usuario  @relation(fields: [vendedorId], references: [id])

  @@index([empresaId])
}

// Fechamento mensal da comissao de um vendedor: soma das Vendas pagas no mes,
// faixa aplicada sobre o total (nao marginal), 1 despesa unica gerada.
model FechamentoComissao {
  id            String   @id @default(cuid())
  mesReferencia DateTime
  totalVendido  Float
  percentual    Float
  valorComissao Float
  createdAt     DateTime @default(now())

  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])

  vendedorId    String
  vendedor      Usuario  @relation(fields: [vendedorId], references: [id])

  despesaId     String   @unique
  despesa       Despesa  @relation(fields: [despesaId], references: [id], onDelete: Cascade)

  @@unique([vendedorId, mesReferencia])
  @@index([empresaId])
}

model DespesaParcela {
  id            String        @id @default(cuid())
  numero        Int
  valor         Float
  vencimento    DateTime
  status        StatusParcela @default(PENDENTE)
  dataPagamento DateTime?

  despesaId     String
  despesa       Despesa       @relation(fields: [despesaId], references: [id], onDelete: Cascade)
}

model ItemEstoque {
  id            String        @id @default(cuid())
  nome          String
  categoria     String?
  quantidade    Int           @default(1)
  valorUnitario Float?
  fornecedor    String?
  dataEntrada   DateTime      @default(now())
  status        StatusEstoque @default(DISPONIVEL)
  observacoes   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  empresaId     String
  empresa       Empresa       @relation(fields: [empresaId], references: [id])

  movimentos    MovimentoEstoque[]

  @@index([empresaId])
}

model MovimentoEstoque {
  id          String               @id @default(cuid())
  tipo        TipoMovimentoEstoque
  quantidade  Int
  data        DateTime             @default(now())
  motivo      String
  observacoes String?
  createdAt   DateTime             @default(now())

  itemEstoqueId String
  itemEstoque   ItemEstoque @relation(fields: [itemEstoqueId], references: [id], onDelete: Cascade)
}

enum StatusDespesaIluminnus {
  PENDENTE
  PAGO
}

// Fluxo de caixa da própria Iluminnus (dona do produto) -- não tem relação
// com Empresa, porque não é gasto de nenhum dono, é gasto da Iluminnus. A
// receita da Iluminnus vem de PagamentoAssinatura (já existe, agregado por
// todas as empresas), não precisa de model próprio.
model DespesaIluminnus {
  id            String                 @id @default(cuid())
  descricao     String
  categoria     String?
  valor         Float
  data          DateTime
  status        StatusDespesaIluminnus @default(PENDENTE)
  dataPagamento DateTime?
  observacoes   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}
