# Copie este arquivo para ".env" e preencha com as credenciais do projeto
# Supabase e o segredo de sessao desta instalacao. Nunca reutilize valores
# de outra empresa/instalacao. Detalhes de cada variavel em DISTRIBUICAO.md.

# Postgres (Supabase) - pooler em transaction mode (porta 6543, com
# ?pgbouncer=true), usada em runtime. NAO use a porta 5432 (session mode)
# aqui -- o limite de conexoes simultaneas e muito menor e estoura sob
# carga em ambiente serverless (Vercel), causando 500 intermitente.
DATABASE_URL=

# Postgres (Supabase) - pooler em session mode (porta 5432), usada só pelo
# Prisma Migrate (DDL nao funciona bem em transaction mode).
DIRECT_URL=

# Chave usada para assinar os JWTs de sessao (staff e cliente).
# Gere uma nova, unica para esta instalacao - nao reaproveite de outra empresa.
SESSION_SECRET=

# Supabase (client-side) - usadas no browser para upload direto de midia
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-side) - usadas para gerar signed upload URLs
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# URL publica do site, usada em sitemap.xml e robots.txt
NEXT_PUBLIC_SITE_URL=
