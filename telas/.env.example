# Copie este arquivo para ".env" e preencha com as credenciais do projeto
# Supabase e o segredo de sessao desta instalacao. Nunca reutilize valores
# de outra empresa/instalacao. Detalhes de cada variavel em DISTRIBUICAO.md.

# Postgres (Supabase) - conexao pooled (transaction mode), usada em runtime
DATABASE_URL=

# Postgres (Supabase) - conexao direta (session mode), usada pelo Prisma Migrate
DIRECT_URL=

# Chave usada para assinar os JWTs de sessao (staff e cliente).
# Gere uma nova, unica para esta instalacao - nao reaproveite de outra empresa.
SESSION_SECRET=

# Supabase (client-side) - usadas no browser para upload direto de midia
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-side) - usadas para gerar signed upload URLs
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# URL publica do site, usada em sitemap.xml e robots.txt
NEXT_PUBLIC_SITE_URL=

# Host do subdominio oficial da Iluminnus pro /admin (o sistema "mae" que
# gerencia os donos do Telas). Precisa estar adicionado como dominio deste
# projeto na Vercel (nao no projeto do site institucional). Sem essa
# variavel, cai no default "admin.iluminnus.com.br".
ADMIN_HOST=
